# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/kora?schema=public"

# Session encryption key for nuxt-auth-utils — generate a long random string,
# e.g. `openssl rand -base64 48`. Never commit the real value.
NUXT_SESSION_PASSWORD="change-me-to-a-long-random-string"

# Public base URL of this app (used for the webhook URL shown in Settings)
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# WhatsApp via SendPulse — see "WhatsApp setup (SendPulse)" in the README.
# Leave the SendPulse keys empty to run in test mode: nothing is sent, messages
# are logged on the server, and Settings → "Try the parent bot" works.
# ---------------------------------------------------------------------------
# SendPulse → Account settings → API → REST API: ID and Secret
SENDPULSE_CLIENT_ID=""
SENDPULSE_CLIENT_SECRET=""
# ID of your WhatsApp bot in SendPulse (Chatbots → your bot)
SENDPULSE_BOT_ID=""
# Long random string, added to the webhook URL so only SendPulse can post to it.
# Required in production. e.g. `openssl rand -hex 24`
SENDPULSE_WEBHOOK_SECRET=""
# Approved WhatsApp template for announcements (body: {{1}} = title, {{2}} = message).
# Without it, announcements go out as plain text, which WhatsApp only delivers
# to parents who messaged the school in the last 24 hours.
WHATSAPP_ANNOUNCEMENT_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
