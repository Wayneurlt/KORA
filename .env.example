# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/kora?schema=public"

# Session encryption key for nuxt-auth-utils — generate a long random string,
# e.g. `openssl rand -base64 48`. Never commit the real value.
NUXT_SESSION_PASSWORD="change-me-to-a-long-random-string"

# Meta WhatsApp Cloud API (used from Phase 6 onward)
WHATSAPP_API_URL="https://graph.facebook.com/v21.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Public base URL of this app (used for webhook callbacks, links in messages)
APP_URL="http://localhost:3000"
