# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/kora?schema=public"

# Session encryption key for nuxt-auth-utils — generate a long random string,
# e.g. `openssl rand -base64 48`. Never commit the real value.
NUXT_SESSION_PASSWORD="change-me-to-a-long-random-string"

# Public base URL of this app (used for the webhook URL shown in Settings)
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API — see "WhatsApp setup" in the README.
# Leave the token / phone number ID empty to run in test mode: nothing is sent,
# messages are logged on the server, and Settings → "Try the parent bot" works.
# ---------------------------------------------------------------------------
WHATSAPP_API_URL="https://graph.facebook.com/v21.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Any string you choose; enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=""
# Meta app secret — used to verify webhook signatures. Required in production.
WHATSAPP_APP_SECRET=""
# Approved template for announcements (body: {{1}} = title, {{2}} = message).
# Without it, announcements go out as plain text, which WhatsApp only delivers
# to parents who messaged the school in the last 24 hours.
WHATSAPP_ANNOUNCEMENT_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
